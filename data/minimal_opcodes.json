{
  "opcodes": {
    "MOVE_CARD": {
      "description": "Move card(s) from one zone to another",
      "parameters": ["from_zone", "to_zone", "card_type", "count"],
      "examples": ["draw", "discard", "place from discard to hand"]
    },
    "RESOURCE_CHANGE": {
      "description": "Add or remove resources (energy, hearts, blades, score)",
      "parameters": ["resource_type", "amount", "operation", "target"],
      "examples": ["gain heart", "pay energy", "lose hearts", "gain blade"]
    },
    "MODIFY_SCORE": {
      "description": "Modify score values",
      "parameters": ["target", "amount", "operation"],
      "examples": ["+2 score", "-1 score"]
    },
    "MODIFY_COST": {
      "description": "Modify cost requirements",
      "parameters": ["target", "amount", "operation"],
      "examples": ["reduce cost by 1", "increase cost"]
    },
    "TAP_CARD": {
      "description": "Change card to tapped/weight state",
      "parameters": ["target", "state"],
      "examples": ["tap member", "untap member"]
    },
    "REVEAL_CARDS": {
      "description": "Look at and reveal cards",
      "parameters": ["zone", "count", "position"],
      "examples": ["look at top 3 cards", "reveal cards"]
    },
    "SEARCH_ZONE": {
      "description": "Search zone for cards matching filters",
      "parameters": ["zone", "filters", "count"],
      "examples": ["search for group members", "find cost <= 4"]
    },
    "SELECT_CARD": {
      "description": "Player selects card(s)",
      "parameters": ["pool", "count", "constraints"],
      "examples": ["choose 1 card", "select up to 2"]
    },
    "SHUFFLE_ZONE": {
      "description": "Shuffle a zone",
      "parameters": ["zone"],
      "examples": ["shuffle deck"]
    },
    "APPLY_RESTRICTION": {
      "description": "Apply temporary restriction",
      "parameters": ["target", "restriction", "duration"],
      "examples": ["cannot move", "cannot activate"]
    },
    "APPLY_MODIFIER": {
      "description": "Apply continuous modifier",
      "parameters": ["target", "modifier", "duration"],
      "examples": ["+1 score while condition holds"]
    },
    "REPLACE_EFFECT": {
      "description": "Replace one effect with another",
      "parameters": ["original", "replacement", "condition"],
      "examples": ["instead of X, do Y"]
    },
    "CHECK_CONDITION": {
      "description": "Check if condition is met",
      "parameters": ["condition", "comparison"],
      "examples": ["if score >= 6", "if zone contains >= 2"]
    },
    "SET_STATE": {
      "description": "Set card or zone state",
      "parameters": ["target", "state", "value"],
      "examples": ["face-up", "face-down", "active"]
    }
  },
  "resource_types": ["energy", "heart", "blade", "score", "required_hearts"],
  "zone_types": ["stage_left", "stage_center", "stage_right", "member_area", "live_card_area", "energy_area", "main_deck", "energy_deck", "hand", "discard", "success_live_pile", "exile", "resolution"],
  "state_flags": ["tap_state", "face_up_state", "cannot_play", "cannot_activate", "cannot_move"],
  "duration_types": ["immediate", "until_end_of_turn", "until_end_of_live", "continuous", "while_condition"]
}
